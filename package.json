{
  "name": "@ifay/cofay",
  "version": "1.1.0",
  "description": "coFay (Common Fay) runnable public-role seat wizard, steward rotation & dual-signed transfer CLI, FayGer BUF\\0 v1 packer, and coFACTS L1 conformance validator.",
  "license": "MIT",
  "type": "module",
  "main": "./src/cofay-charter.mjs",
  "types": "./src/cofay-charter.d.ts",
  "bin": {
    "cofay": "./bin/cofay.mjs"
  },
  "exports": {
    ".": {
      "types": "./src/cofay-charter.d.ts",
      "import": "./src/cofay-charter.mjs"
    },
    "./buf": "./src/cofay-buf.mjs",
    "./wizard": "./src/cofay-seat-wizard.mjs",
    "./schemas/role-charter-1.0": "./schemas/cofay-role-charter-1.0.json",
    "./vectors/role-charter-1.0": "./vectors/cofay-role-charter-vectors.json"
  },
  "files": [
    "bin",
    "src",
    "schemas",
    "schema",
    "vectors",
    "docs",
    "README.md",
    "LICENSE",
    "LICENSE-DOCS"
  ],
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "demo": "node ./bin/cofay.mjs demo"
  }
}
